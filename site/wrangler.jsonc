// dsh-worker 的 Wrangler 配置。
//
// 故意不写 account_id：Workers Builds 部署的是后台里已绑定本仓库的 Worker，
// 账号在连接时就已确定，配置里不需要（官方 C3 模板也不带这个字段）；
// 本地跑 deploy / d1 migrations --remote 时，wrangler 会用 `wrangler login`
// 的 OAuth 凭证解析账号。没必要把账号 ID 提交进仓库。
//
// Workers Builds 的 Root directory 设为 `site`，所以这个文件必须在 site/ 下，
// 且 `main` 相对于本文件解析。
//
// `name` 必须与 Cloudflare 后台的 Worker 名一致（dsh-worker）——
// Workers Builds 会用 `WRANGLER_CI_OVERRIDE_NAME` 覆盖它，但保持一致更省心。
//
// `main` 指向 make-bundle.mjs 生成的产物：整个站点被 gzip + base64 嵌进
// 一段自包含 Worker 脚本（见 site/README.md「为什么是『把文件嵌进 Worker』」）。
//
// `build.command` 让 wrangler 在 deploy 之前现场生成入口文件。这一条不是
// 锦上添花，是 2026-10-28 的教训：CI 的 Build command 字段一旦没填/没跑，
// deploy 会直接报「The entry-point file at "worker/bundle.js" was not
// found」。生成物（gitignore 的 worker/bundle.js）不该依赖 dashboard 上
// 另一个字段有没有填对——谁要用它，谁就负责把它造出来。
{
  "name": "dsh-worker",
  "main": "worker/bundle.js",
  "build": {
    "command": "node build.mjs && node make-bundle.mjs"
  },
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  // 匿名使用统计（DEC-020）：心跳写进 D1，每天 UTC 10:42 汇总后推 Bark。
  //
  // 注意两件事：
  //
  //   1. `wrangler deploy` **不会**自动执行迁移。上线前必须手动跑一次
  //      `npx wrangler d1 migrations apply dsh-telemetry --remote`，
  //      否则 Worker 里第一条 INSERT 就会因为表不存在而失败。
  //   2. cron 只认 UTC：10:42 UTC = 18:42 Asia/Shanghai（中国无夏令时，
  //      全年恒为 +8，所以这个换算不需要季节性调整）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsh-telemetry",
      "database_id": "e828893a-5f98-444a-9082-71910bd705ae",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["42 10 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
