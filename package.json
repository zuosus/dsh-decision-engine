{
  "name": "dsh-decision-engine",
  "version": "2.3.0",
  "description": "dsh-decision-engine: a judgement layer for DeepSeek Harness — before the main model acts, a small, cheap decision model judges each call: allow, escalate, reroute to a cheaper model, or skip. The plugin provides a free decision model, so a fresh install works out of the box; any other service exposing a decision endpoint can be plugged in (built-in presets or a custom base URL). All nine decision points (tool authorization, model routing, delegation, subagent model selection, compaction, turn continuation, retrieval, skill pick, COT translation) are implemented and individually switchable.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./providers": "./lib/providers.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/client-src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "config.example.yml",
    "icon.svg",
    "locale",
    "docs/assets",
    "scripts/migrate-profile.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "decision-engine",
    "startlux",
    "decisions",
    "typesafe",
    "jev",
    "siliconflow",
    "siliconflow-cn",
    "kev-4b",
    "provider",
    "custom-base-url",
    "tool-approval",
    "risk-gating",
    "model-routing",
    "compaction",
    "session-title",
    "translation-gate"
  ],
  "engines": {
    "node": ">=20.3.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "license": "MIT",
  "author": "zuosus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuosus/dsh-decision-engine.git"
  },
  "bugs": {
    "url": "https://github.com/zuosus/dsh-decision-engine/issues"
  },
  "homepage": "https://github.com/zuosus/dsh-decision-engine#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/",
    "verify:endpoint": "node scripts/verify-endpoint.mjs",
    "verify:wiring": "node scripts/verify-wiring.mjs",
    "verify": "node --test test/ && node scripts/verify-wiring.mjs"
  }
}
