{
  "name": "dsh-startlux-decision",
  "version": "0.1.0",
  "description": "System-1 judgement for every tool call in DeepSeek Harness, purpose-built for Bamboo Relay / StartLux decisions: shadow-first risk gating, fail-open by construction, token-frugal.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "startlux.example.yml"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "startlux",
    "bamboo",
    "bamboo-relay",
    "decisions",
    "system-one",
    "system-1",
    "tool-approval",
    "risk-gating"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "license": "MIT",
  "author": "zuosus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuosus/dsh-startlux-decision.git"
  },
  "bugs": {
    "url": "https://github.com/zuosus/dsh-startlux-decision/issues"
  },
  "homepage": "https://github.com/zuosus/dsh-startlux-decision#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
