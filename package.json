{
  "name": "dsh-decision-engine",
  "version": "0.6.1",
  "description": "dsh-decision-engine: a cheap judgement layer for DeepSeek Harness — all nine decision points (tool authorization, model routing, delegation, compaction, turn continuation, retrieval, skill pick, session title, COT translation) are implemented and individually switchable, and it works against any system-one style API (system one, bamboonode, or a custom base URL).",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./providers": "./lib/providers.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "config.example.yml",
    "icon.svg",
    "locale",
    "scripts/migrate-profile.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "decision-engine",
    "startlux",
    "bamboo",
    "bamboo-relay",
    "decisions",
    "system-one",
    "system-1",
    "typesafe",
    "jev",
    "provider",
    "custom-base-url",
    "tool-approval",
    "risk-gating",
    "model-routing",
    "compaction",
    "session-title",
    "translation-gate"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "license": "MIT",
  "author": "zuosus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuosus/dsh-decision-engine.git"
  },
  "bugs": {
    "url": "https://github.com/zuosus/dsh-decision-engine/issues"
  },
  "homepage": "https://github.com/zuosus/dsh-decision-engine#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
    "test": "node --test test/",
    "verify:endpoint": "node scripts/verify-endpoint.mjs",
    "verify:wiring": "node scripts/verify-wiring.mjs",
    "verify": "node --test test/ && node scripts/verify-wiring.mjs"
  }
}
