{
  "name": "dsh-startlux-decision",
  "version": "0.1.1",
  "description": "StartLux decision guard for DeepSeek Harness: four typed questions before every tool call, fail-open by default.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "startlux.example.yml",
    "icon.svg",
    "locale"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "startlux",
    "bamboo",
    "bamboo-relay",
    "decisions",
    "system-one",
    "system-1",
    "tool-approval",
    "risk-gating"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "license": "MIT",
  "author": "zuosus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuosus/dsh-startlux-decision.git"
  },
  "bugs": {
    "url": "https://github.com/zuosus/dsh-startlux-decision/issues"
  },
  "homepage": "https://github.com/zuosus/dsh-startlux-decision#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
