# 用户实际配置（含 API key）——绝不入库
config.yml
# 旧文件名：升级后可能还留在工作副本里，同样不入库
startlux.yml

# 运行时遥测（含真实工具调用记录）
telemetry.jsonl
telemetry.jsonl.old
# 匿名统计的本地状态（含安装 id，属于本机隐私数据）
analytics.json
analytics.json.tmp
*.log

# 依赖与系统文件
node_modules/
node_modules
.DS_Store
*.tgz

# 站点构建产物与部署凭据
site/dist/
site/worker/
site/.env*
